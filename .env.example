# 환경변수 예시. 값이 없으면 application.yml의 기본값(compose.yaml 로컬 MySQL)을 쓴다.
DB_URL=jdbc:mysql://localhost:3306/jinsangstop?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=jinsangstop
DB_PASSWORD=jinsangstop-local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_TIMEOUT=1d
VOICE_SERVICE_URL=http://127.0.0.1:8000
VOICE_CONNECT_TIMEOUT=2s
VOICE_HEALTH_TIMEOUT=3s
VOICE_TRANSCRIBE_TIMEOUT=60s
TRAINING_IDLE_TIMEOUT=10m
TRAINING_MAX_AUDIO_BYTES=26214400
INFERENCE_SERVICE_URL=http://127.0.0.1:8081
INFERENCE_CONNECT_TIMEOUT=2s
INFERENCE_HEALTH_TIMEOUT=3s
INFERENCE_COMPLETION_TIMEOUT=60s
ACTING_TEMPERATURE=0.8
ACTING_MAX_TOKENS=200
ACTING_WARMUP_ENABLED=true
ABSOLUTE_LINES_DOCUMENT=classpath:safety/absolute-lines.txt
SCORING_SEED=42
SCORING_MAX_TOKENS=300
SCORING_MODE=PARALLEL
SCORING_RESPONSE_WAIT=1s
SCORING_WARMUP_ENABLED=true
